<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Mensaje</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1>Nuevo mensaje</h1>
    <form method="POST" action="new">
        <div class="form-group">
            <label for="messageUser">Tu nombre</label>
            <input 
            type="text"
            id= "messageUser"
            name="messageUser"
            required
            maxlength="50"
            />
        </div>
        <div class="form-group">
            <label for="messageText">Mensaje</label>
            <textarea 
                id="messageText"
                name="messageText"
                required
                maxlength="500"
                rows="5" 
            ></textarea>
        </div>
        <button type="submit" class="btn">Enviar</button>
        <a href="/" class="btn-outline">Cancelar</a>
    </form>
</body>
</html>