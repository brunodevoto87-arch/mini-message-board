<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo Mensaje</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <% if (errors && errors.length > 0){ %>
        <ul class="errors">
            <% errors.forEach(function(error){ %>
                <li><%= error.msg %></li>
            <%}); %>
        </ul>
     <% } %>
     <form method="POST" action="/new">
        <div class="form-group">
            <label for="messageUser">Tu Nombre</label>
            <input 
            type="text"
            id="messageUser"
            name="messageUser"
            value="<%= oldData ? oldData.messageUser : '' %>"
            maxlength="50"
            />
        </div>
        <div class="form-group">
            <label for="messageText">Mensaje</label>
            <textarea  
            id="messageText"
            name="messageText"
            maxlength="500"
            rows="5"
            ><%= oldData ? oldData.messageText : '' %></textarea>
        </div>
        <button type="submit" class="btn">Enviar</button>
        <a href="/" class="btn-outline">Cancelar</a>
     </form>
</body>
</html>