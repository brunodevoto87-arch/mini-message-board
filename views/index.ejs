<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <h1><%= title %></h1>
    <a href="/new" class="btn">+ Nuevo Mensaje</a>
    <ul class="messages">
        <% messages.forEach(function(message){
            %> <li class="message">
                <strong><%= message.user %></strong>
                <span class="date"><%= message.added.toLocaleString() %></span>
                <p><%= message.text %></p>
                <div class="message-actions">
                    <a href="/message/<%= message.id %>" class="btn-small">Abrir</a>
                    <form action="/message/<%= message.id %>/delete" method="POST" style="display:inline;">
                        <button type="submit" class="btn-small btn-danger">Eliminar</button>
                    </form>
                </div>
            </li>
        <% }); %>
    </ul>
</body>
</html>